# ENGINEERING-BASELINE-001: editor and encoding conventions for newly created
# or intentionally modified files (Python, Markdown, TOML, JSON, YAML,
# PowerShell, GitHub workflows). Applies prospectively only: it does not repair
# pre-existing encoding damage and does not authorize bulk reformatting.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4

[*.{md,markdown}]
indent_style = space
indent_size = 4

[*.toml]
indent_style = space
indent_size = 2

[*.{json,jsonc}]
indent_style = space
indent_size = 2

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{ps1,psm1}]
indent_style = space
indent_size = 4
